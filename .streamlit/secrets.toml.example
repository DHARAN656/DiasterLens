# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is gitignored — never commit it.
#
# On Streamlit Community Cloud: paste these key=value pairs into
# Settings → Secrets (no [section] header needed there).

AWS_DEFAULT_REGION = "us-east-1"
AWS_ACCESS_KEY_ID = "AKIA..."
AWS_SECRET_ACCESS_KEY = "..."
# AWS_SESSION_TOKEN = "..."   # only needed for temporary STS credentials

S3_BUCKET = "your-bucket-name"

MARENGO_MODEL_ID = "twelvelabs.marengo-embed-3-0-v1:0"
PEGASUS_MODEL_ID  = "twelvelabs.pegasus-1-2-v1:0"
CLAUDE_MODEL_ID   = "us.anthropic.claude-sonnet-4-6"
